# ---- ElevenLabs Voice Agent ----
# Required to create/run the voice agent (https://elevenlabs.io/app/settings/api-keys)
XI_API_KEY=

# Public URL where ElevenLabs can reach this API.
# Leave BLANK to let the setup script auto-start ngrok (needs NGROK_AUTHTOKEN or ngrok on PATH).
NEXUS_WEBHOOK_URL=

# Optional: override the default voice (a public preset is used if blank)
ELEVENLABS_VOICE_ID=

# Optional: shared secret sent as X-ElevenLabs-Secret header (verified by the API)
ELEVENLABS_WEBHOOK_SECRET=

# Optional: ngrok authtoken so the setup script can auto-expose the API
NGROK_AUTHTOKEN=

# ---- Generic LLM narrator (via litellm) ----
# When NEXUS_LLM_ENABLED=true, an LLM writes the spoken explanation the ElevenLabs
# agent reads. The clearing MATH stays deterministic in ai/nexus (brief D5).
# The model string selects the provider -- nothing is hardcoded to a vendor:
#   openai/gpt-4o-mini
#   gemini/gemini-1.5-flash
#   anthropic/claude-3-5-haiku-latest
#   nvidia_nim/meta/llama-3.1-8b-instruct
#   or any OpenAI-compatible model when NEXUS_LLM_BASE_URL is set
NEXUS_LLM_ENABLED=false
NEXUS_LLM_MODEL=
NEXUS_LLM_API_KEY=
# Optional: point at a self-hosted or OpenAI-compatible endpoint (e.g. NIM / vLLM)
NEXUS_LLM_BASE_URL=