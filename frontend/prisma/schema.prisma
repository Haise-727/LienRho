// LienRho — CSI ORIGIN 2026, Problem Statement 5.
// Track 1: marketplace data backbone + Stitch-style double-entry ledger.
//
// Two rules this schema is built around, carried from docs/00-brief.md:
//   1. Money is never a float. Every amount is Decimal(18,2), every rate
//      Decimal(9,6). A float rupee is a rounding bug waiting for the demo.
//   2. Verification is a graded tier, never a boolean — providers price the
//      difference, and flattening it destroys the information that makes the
//      market efficient (docs/01-commerce-analysis.md §8).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 moved connection URLs out of the schema: the CLI reads them from
  // prisma.config.ts, and the client gets a driver adapter (src/lib/db.ts).
  // Supabase pools on 6543 (transaction mode) and cannot run DDL, so `db push`
  // and `migrate` go direct on 5432 via DIRECT_URL.
}

// ---------------------------------------------------------------- base entities

enum OrgType {
  SUPPLIER
  PROVIDER
  PLATFORM
}

/// A tenant. Party type is on the org itself because a provider must never see
/// another provider's mandate or bids — that is a tenancy rule, not a UI one.
model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  taxId     String?  @unique
  createdAt DateTime @default(now())

  customers     Customer[]
  invoices      Invoice[]
  provider      CapitalProvider?
  accounts      Account[]
  opportunities FinancingOpportunity[]

  @@index([type])
}

/// The buyer who owes the invoice. Passive: a verification target and a credit
/// input, not a user of the platform.
model Customer {
  id                       String  @id @default(cuid())
  orgId                    String
  name                     String
  taxId                    String?
  industry                 String?
  /// Realised payment behaviour — a credit input providers price against.
  averageDelayDays         Float?
  relationshipDurationDays Int?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([orgId])
}

/// How strong the claim behind an opportunity actually is. Graded, and disclosed
/// to providers — the whole anti-adverse-selection mechanism depends on it.
enum VerificationTier {
  /// Buyer has formally acknowledged the debt. Priced closest to buyer credit.
  BUYER_ACCEPTED
  /// Present and consistent in the supplier's ledger, with delivery evidence.
  LEDGER_VERIFIED
  /// Claimed, unconfirmed. Many providers decline outright.
  SUPPLIER_ASSERTED
}

model Invoice {
  id            String           @id @default(cuid())
  orgId         String
  customerId    String
  invoiceNumber String
  faceValue     Decimal          @db.Decimal(18, 2)
  currency      String           @default("INR")
  invoiceDate   DateTime
  dueDate       DateTime
  /// Set only when the buyer formally accepted. Drives BUYER_ACCEPTED tier.
  acceptanceDate DateTime?
  verificationTier VerificationTier @default(SUPPLIER_ASSERTED)
  /// Invoice / purchase-order / proof-of-delivery agreement. What actually earns
  /// LEDGER_VERIFIED rather than SUPPLIER_ASSERTED.
  threeWayMatched Boolean @default(false)

  /// Anti-double-financing (docs/01-commerce-analysis.md §8.5).
  /// sha256(sellerTaxId | buyerTaxId | invoiceNumber). A unique constraint, not a
  /// service. Catches the same invoice presented twice under an unchanged
  /// identifier; a fabricated near-duplicate needs the 3-way match instead.
  fingerprint String @unique

  createdAt DateTime @default(now())

  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer      Customer               @relation(fields: [customerId], references: [id])
  opportunities FinancingOpportunity[]

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([customerId])
}

// ------------------------------------------------------------------ marketplace

enum ProviderArchetype {
  BANK
  NBFC
  FINTECH
  CREDIT_FUND
  SECTOR_SPECIALIST
}

/// A capital provider's private mandate.
///
/// Nothing in here may be read by the scoring engine. If provider pricing is
/// generated by the same logic that later scores it, the market is theatre and
/// any "intelligent matching" result is circular (docs/01-commerce-analysis.md §6).
model CapitalProvider {
  id        String            @id @default(cuid())
  orgId     String            @unique
  name      String
  archetype ProviderArchetype

  /// Annualised cost of funds. The floor under anything it can quote.
  costOfFunds Decimal @db.Decimal(9, 6)
  /// Minimum risk-adjusted return it will accept before deploying.
  hurdleRate  Decimal @db.Decimal(9, 6)

  totalLiquidity     Decimal @db.Decimal(18, 2)
  /// Free capital. Drops as EscrowLocks are taken and matches disburse.
  availableLiquidity Decimal @db.Decimal(18, 2)

  minTicket Decimal @db.Decimal(18, 2)
  maxTicket Decimal @db.Decimal(18, 2)
  minTenorDays Int
  maxTenorDays Int

  /// Worst risk grade it will touch at any price (A best .. E worst).
  riskAppetiteFloor String
  /// Cap on exposure to any single buyer, as a fraction of total liquidity.
  concentrationLimitPct Decimal @db.Decimal(9, 6)
  /// Business days from match to cash landing. T+0 / T+1 / T+3.
  settlementDays Int
  /// Sector focus for SECTOR_SPECIALIST; empty means generalist.
  sectorFocus String[] @default([])

  /// Realised reliability, learned from quoted-vs-delivered settlement.
  /// Starts at 1.0 and is adjusted by the learning loop (Track 2/3).
  reliabilityScore Decimal @default("1.0") @db.Decimal(9, 6)

  createdAt DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bids        Bid[]
  matches     Match[]
  escrowLocks EscrowLock[]

  @@index([archetype])
}

/// The lifecycle from docs/03-system-design.md Module 9. Spans the whole
/// opportunity, not just post-match — a match is not complete because an offer
/// was accepted.
enum OpportunityStatus {
  RECEIVED
  VERIFIED
  AUCTION_LIVE
  MATCHED
  DISBURSING
  DISBURSED
  AWAITING_BUYER
  BUYER_PAID
  RESERVE_RELEASED
  CLOSED
  /// Nothing cleared the supplier's floor. A market that always transacts is
  /// not exercising judgement.
  NO_MATCH
  DEFAULTED
  DISPUTED
}

model FinancingOpportunity {
  id        String            @id @default(cuid())
  orgId     String
  invoiceId String
  status    OpportunityStatus @default(RECEIVED)

  requestedAmount Decimal @db.Decimal(18, 2)
  tenorDays       Int

  /// Risk engine output, consumed by providers when they price.
  riskGrade         String?
  /// Probability of default. Calibration here is market infrastructure, not a
  /// leaderboard number — a provider pricing off an uncalibrated PD is misled.
  probabilityOfDefault Decimal? @db.Decimal(9, 6)
  expectedDilutionPct  Decimal? @db.Decimal(9, 6)

  /// Supplier utility, derived from the cash forecast rather than asked for
  /// (docs/01-commerce-analysis.md §4). These two are lexicographic gates:
  /// an offer failing either is disqualified, not merely ranked lower.
  sufficiencyFloor Decimal?  @db.Decimal(18, 2)
  timingDeadline   DateTime?
  /// Inferred position on the urgency-vs-cost axis, 0 = pure cost, 1 = pure
  /// urgency. Shown to the supplier pre-positioned; they may nudge it.
  urgencyWeight    Decimal   @default("0.5") @db.Decimal(9, 6)

  auctionClosesAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bids          Bid[]
  match         Match?
  journalEntries JournalEntry[]
  escrowLocks   EscrowLock[]

  @@index([status])
  @@index([orgId])
}

enum RepaymentStructure {
  /// Repaid in full when the buyer pays. The default for receivables discounting.
  BULLET
  AMORTISING
  REVOLVING
}

enum BidStatus {
  ACTIVE
  WITHDRAWN
  EXPIRED
  WON
  LOST
}

/// One provider's competing offer.
///
/// The four attributes Track 2's Pareto/MAU function ranks on are `advanceRate`,
/// `annualRate` (APR), `settlementDays` (disbursal latency) and `flatFee` —
/// deliberately non-dominating, so a real frontier exists.
model Bid {
  id            String @id @default(cuid())
  opportunityId String
  providerId    String

  /// Annualised discount charge applied to the advance. The headline number,
  /// and the most over-weighted one.
  annualRate  Decimal @db.Decimal(9, 6)
  /// Share of face value paid upfront, 0..1. Dominates rate on short tenors.
  advanceRate Decimal @db.Decimal(9, 6)
  /// Flat processing fee. Regressive — it hurts small invoices hardest.
  flatFee     Decimal @db.Decimal(18, 2)
  tenorDays   Int
  /// Business days from match to cash landing. Quoted, not yet delivered.
  settlementDays Int
  /// Non-recourse transfers real default risk to the provider and is worth
  /// paying for.
  recourse       Boolean            @default(true)
  repaymentStructure RepaymentStructure @default(BULLET)

  status    BidStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  /// Deterministic scoring output (Track 2). Nullable until the auction clears.
  /// Every one of these must trace to a named function — no LLM writes them.
  netCashToSupplier Decimal?  @db.Decimal(18, 2)
  /// The honest comparator, and not the headline rate.
  effectiveAnnualCost Decimal? @db.Decimal(9, 6)
  projectedArrival    DateTime?
  utilityScore        Decimal?  @db.Decimal(9, 6)
  rank                Int?
  /// Why a bid was disqualified: fails sufficiency floor, misses the deadline,
  /// breaches concentration. Empty when it cleared every gate.
  gateFailures        String[]  @default([])

  opportunity FinancingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  provider    CapitalProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  match       Match?

  @@unique([opportunityId, providerId])
  @@index([opportunityId])
  @@index([providerId])
  @@index([status])
}

/// The winning allocation. Constraints are re-checked and snapshotted here at
/// allocation time, because a provider's position may have moved since it bid.
model Match {
  id            String @id @default(cuid())
  opportunityId String @unique
  bidId         String @unique
  providerId    String

  /// Face-value share allocated to this provider. Below the full requested
  /// amount when the fill is partial (syndication is a stretch goal).
  allocatedAmount Decimal @db.Decimal(18, 2)
  advanceAmount   Decimal @db.Decimal(18, 2)
  discountCharge  Decimal @db.Decimal(18, 2)
  feeAmount       Decimal @db.Decimal(18, 2)
  netDisbursed    Decimal @db.Decimal(18, 2)
  /// (1 - advanceRate) x face. Released to the supplier only after the buyer
  /// pays, less any dilution.
  reserveAmount   Decimal @db.Decimal(18, 2)

  /// What the winning bid promised, kept so delivered-vs-quoted is computable.
  quotedSettlementDays Int
  quotedDisbursalDate  DateTime
  actualDisbursalDate  DateTime?
  expectedBuyerPayment DateTime
  actualBuyerPayment   DateTime?

  /// Provider constraint snapshot at allocation. Proves the allocation was
  /// legal when it was made, even after the provider's position moves.
  constraintSnapshot Json?

  matchedAt DateTime @default(now())

  opportunity FinancingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  bid         Bid                  @relation(fields: [bidId], references: [id])
  provider    CapitalProvider      @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

// ------------------------------------------- Stitch-style double-entry ledger
//
// Stitch (stitch.co) provides "a programmable double-entry ledger that records
// every movement of money in real time". This is that model, applied to the
// two events the marketplace has to get right without double-counting:
// Day 0 disbursement and Day 90 buyer repayment.
//
// The invariant: every JournalEntry's postings sum to zero (total debits equal
// total credits). Enforced in src/lib/ledger/post.ts inside the same
// transaction that writes them, so an unbalanced entry cannot reach the table.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// One account in the chart of accounts. `code` is the stable human-readable
/// handle (e.g. `provider:aurora:cash`); ids are opaque.
model Account {
  id       String      @id @default(cuid())
  code     String      @unique
  name     String
  type     AccountType
  /// Null for platform-level accounts that belong to no tenant.
  orgId    String?
  currency String      @default("INR")
  createdAt DateTime   @default(now())

  org      Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  postings Posting[]

  @@index([orgId])
  @@index([type])
}

/// The economic events the ledger records.
enum LedgerEventType {
  /// Provider advances cash; supplier receives net of discount and fee.
  DISBURSEMENT
  /// Buyer settles the invoice into platform escrow.
  BUYER_PAYMENT
  /// Escrow distributes: provider recovers its advance, supplier gets the reserve.
  RESERVE_RELEASE
  /// Capital committed against a live bid, before any cash moves.
  ESCROW_HOLD
  ESCROW_RELEASE
  FEE_COLLECTION
  WRITE_OFF
  ADJUSTMENT
}

/// One balanced transaction. Immutable once written — a correction is a new
/// reversing entry, never an edit, because the trail is the product.
model JournalEntry {
  id            String          @id @default(cuid())
  /// Idempotency key. A retried disbursement must not post twice — this is the
  /// "without double-counting" requirement, enforced by the database.
  reference     String          @unique
  eventType     LedgerEventType
  description   String
  opportunityId String?
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())
  metadata      Json?

  opportunity FinancingOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  postings    Posting[]

  @@index([opportunityId])
  @@index([eventType])
}

enum PostingDirection {
  DEBIT
  CREDIT
}

/// One leg of a journal entry. Amounts are always positive; `direction` carries
/// the sign. Debits increase ASSET/EXPENSE accounts and decrease the rest.
model Posting {
  id             String           @id @default(cuid())
  journalEntryId String
  accountId      String
  direction      PostingDirection
  amount         Decimal          @db.Decimal(18, 2)
  currency       String           @default("INR")
  createdAt      DateTime         @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

enum EscrowLockStatus {
  /// Capital committed against a live bid.
  HELD
  /// Bid lost or expired; capital returned to available liquidity.
  RELEASED
  /// Bid won and disbursed; the hold became a real outflow.
  CAPTURED
}

/// A hold on a provider's liquidity while its bid is live.
///
/// This is the concurrency seam (docs/03-system-design.md Module 8): two
/// opportunities can legitimately try to draw down the same provider's
/// remaining liquidity at once. Track 2 layers Redis SETNX on top for fast
/// rejection, but correctness rests here — the row is written in the same
/// Postgres transaction that decrements availableLiquidity, so a lost Redis
/// lock degrades throughput, never correctness.
model EscrowLock {
  id            String           @id @default(cuid())
  providerId    String
  opportunityId String
  amount        Decimal          @db.Decimal(18, 2)
  status        EscrowLockStatus @default(HELD)
  /// Holds expire so a crashed auction cannot strand a provider's capital.
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  releasedAt    DateTime?

  provider    CapitalProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  opportunity FinancingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// One live hold per provider per opportunity. Makes a double-hold a database
  /// error rather than a silent over-commitment of capital.
  @@unique([providerId, opportunityId])
  @@index([status])
  @@index([expiresAt])
}
