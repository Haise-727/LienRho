# LienRho — copy to `.env` and fill in the password. `.env` is gitignored.
#
# ---------------------------------------------------------------- database
# Shared Supabase project (Sprint 1): ref pxnqvhsftbcpimhhitjf, ap-northeast-1.
# All four tracks point at this one database. Ask Ragav for the password.
#
# DATABASE_URL  transaction pooler (6543) — the app at runtime.
#               pgbouncer=true stops Prisma using prepared statements, which the
#               transaction pooler does not support. connection_limit=1 keeps a
#               serverless runtime from exhausting the free tier's pool.
# DIRECT_URL    direct connection (5432) — db push / migrate / seed only.
#               DDL cannot run through the transaction pooler.
#
# Both are also at: Supabase > Project > Connect > ORMs > Prisma

DATABASE_URL="postgresql://postgres.pxnqvhsftbcpimhhitjf:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.pxnqvhsftbcpimhhitjf:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Local alternative — use this if you want a database you can freely wipe:
#   docker compose up -d          # from the repo root
#   npm run db:push && npm run db:seed
# DATABASE_URL="postgresql://lienrho:lienrho@localhost:5432/lienrho"
# DIRECT_URL="postgresql://lienrho:lienrho@localhost:5432/lienrho"

# ---------------------------------------------------------------- optional
# Legacy FastAPI proxy target, read by src/lib/api.ts. Only matters for the
# carried-over screens; defaults to http://localhost:8000 when unset.
# NEXT_PUBLIC_API_URL="http://localhost:8000"

# Track 2 — Redis for allocation locks. `docker compose up -d` provides this.
# REDIS_URL="redis://localhost:6379"

# Track 3 — ElevenLabs voice. Not read by any code yet.
# ELEVENLABS_API_KEY=""

# --- Supabase Auth (#25 — Google OAuth) ---------------------------------------
# Both are safe in the browser: the anon key is the publishable one, and Row
# Level Security is what protects data, not the secrecy of this key.
# NEVER put the service_role key here — it bypasses RLS entirely.
#
# Get them from: Supabase Dashboard > Project Settings > API
#   Project URL  ->  NEXT_PUBLIC_SUPABASE_URL
#   anon public  ->  NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Also required, once, in the dashboard:
#   1. Authentication > Providers > Google — enable, paste the Client ID and
#      Secret from Google Cloud Console.
#   2. Authentication > URL Configuration > Redirect URLs — add
#      http://localhost:3000/auth/callback (and the deployed origin later).
#
# Sign-in is an ALLOWLIST: a Google account can only get in if its email is a
# row in the `User` table. Seeded rows use .example addresses, so swap them for
# real ones in prisma/seed.ts before demoing, or nobody can sign in.

NEXT_PUBLIC_SUPABASE_URL="https://pxnqvhsftbcpimhhitjf.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
